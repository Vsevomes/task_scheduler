#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="${STARPU_DOCKER_IMAGE:-starpu-cuda-rtx4060}"

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Image '$IMAGE' not found. Run: ./scripts/build-docker.sh"
  exit 1
fi

GPU_ARGS=()
if [[ "${USE_GPU:-0}" == "1" ]]; then
  GPU_ARGS=(--gpus all)
fi

docker run --rm "${GPU_ARGS[@]}" \
  -v "$ROOT:/workspace" \
  -w /workspace \
  -u "$(id -u):$(id -g)" \
  "$IMAGE" \
  bash -lc '
    set -euo pipefail
    mkdir -p build
    cd build
    cmake .. \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES=89
    cmake --build . -j"$(nproc)"
    echo ""
    echo "Build complete. Binaries in build/"
    ls -1 bench_* hello_starpu 2>/dev/null || true
  '
